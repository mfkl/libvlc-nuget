<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('-macos'))">
    <SupportedOSPlatformVersion>11.0</SupportedOSPlatformVersion>
    <ApplicationId>org.videolan.libvlcnuget.smoke</ApplicationId>
    <ApplicationTitle>Smoke</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <CodesignKey>-</CodesignKey>
    <UseHardenedRuntime>false</UseHardenedRuntime>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="$(NativePackageVersion)" />
    <PackageReference Include="LibVLCSharp" Version="$(LoaderPackageVersion)" />
  </ItemGroup>
</Project>
