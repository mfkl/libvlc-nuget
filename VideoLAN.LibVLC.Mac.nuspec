<?xml version="1.0"?>
<package >
  <metadata>
    <id>VideoLAN.LibVLC.Mac</id>
    <title>VideoLAN.LibVLC.Mac</title>
    <version>3.1.3.2-macos.1</version>
    <authors>VideoLAN</authors>
    <owners>VideoLAN</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>LibVLC is a modular multimedia framework</summary>
    <description>LibVLC is a modular multimedia framework that can render video and output audio as well as encode and stream. 
As it is native code, you will need to use a wrapper library such as LibVLCSharp to use it from .NET.</description>
    <tags>libvlc;vlc;videolan;native;c/c++;video;audio;player;media;mediaplayer;codec;ffmpeg;xamarin;graphics;ios;android;linux;windows;macos;cross-platform</tags>
    <projectUrl>https://code.videolan.org/videolan/libvlc-nuget</projectUrl>
    <license type="expression">LGPL-3.0-or-later</license>
    <icon>icon.png</icon>
    <readme>README.macos.md</readme>
    <releaseNotes>LibVLC 3.0.23, separate macOS x64 and arm64 runtimes. Upgrade LibVLCSharp to the companion 3.10.2-macos.1 preview before upgrading this native package. Older unpatched loaders are unsupported; see the packaged README.macos.md for compatibility and upgrade instructions.</releaseNotes>
  </metadata>
  <files>
    <file src="build\VideoLAN.LibVLC.Mac.targets" target="build\VideoLAN.LibVLC.Mac.targets"/>
    <file src="build\VideoLAN.LibVLC.Mac.targets" target="buildTransitive\VideoLAN.LibVLC.Mac.targets"/>
    <file src="build\macos\osx-x64\**\*" target="build\macos\osx-x64"/>
    <file src="build\macos\osx-arm64\**\*" target="build\macos\osx-arm64"/>
    <file src="icon.png" target="" />
    <file src="buildsystem\macos\README.md" target="README.macos.md" />
  </files>
</package>
